        "messages": {
          "values": [
            {
              "content": "You are a senior B2B Sales Development Representative (SDR). Analyze the scraped local business lead JSON (including website CMS/tech stack, missing Meta Pixel / Google Ads flags, and recent customer review hook) and return a JSON object with exactly 4 keys: \"aiHeadline\" (company name + category + ICP fit tier), \"aiVerdict\" (one of: TIER_1_HOT, TIER_2_WARM, TIER_3_NURTURE), \"aiAnalysis\" (1-sentence digital presence or marketing gap hypothesis based on rating, review count, website CMS, and pixel/ad-tag gaps), and \"aiDraftBody\" (a personalized 4-sentence cold outreach email referencing their recent customer review hook and offering a low-friction call to action).",
              "role": "system"
            },
            {
              "content": "=Lead Record ({{ $json.recordId }}):\nTitle/Business: {{ $json.titleText }} ({{ $json.primary_category || 'Local Business' }})\nEmail: {{ $json.primary_email || 'N/A' }} | Phone: {{ $json.phone || 'N/A' }}\nWebsite: {{ $json.website || $json.itemUrl }} (CMS: {{ $json.website_cms || 'N/A' }})\nOpportunity Flags: {{ JSON.stringify($json.agency_opportunity_flags || []) }}\nRating / Reviews: {{ $json.rating || 'N/A' }} ({{ $json.reviews_count || 0 }} reviews)\nCustomer Review Hook: {{ $json.review_hook_text || 'N/A' }}\nLead Score: {{ $json.numericValue }} (Priority: {{ $json.priorityScore }}/100)\nRaw Payload Summary: {{ JSON.stringify($json).slice(0, 1200) }}",
              "role": "user"
            }
          ]
        },
        "jsonOutput": true,
        "options": {
