              "value": "YOUR_APIFY_API_TOKEN",
              "type": "string"
            },
            {
              "id": "9f70093c-0d29-5bd8-b85c-4600a6311f51",
              "name": "actorInput",
              "value": "{\"searchQuery\": \"iphone 15\", \"zipCode\": \"90001\", \"startUrls\": [], \"proxyConfiguration\": {\"useApifyProxy\": true, \"apifyProxyGroups\": [\"RESIDENTIAL\"], \"apifyProxyCountry\": \"US\"}}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "d9cacf32-e752-5016-935e-94503ce4c40a",
      "name": "1. Set Apify Token & Input",
