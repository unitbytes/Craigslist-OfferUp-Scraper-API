      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/unitbytes~offerup-scraper/run-sync-get-dataset-items?token={{ $json.apifyToken }}&format=json&clean=true",
