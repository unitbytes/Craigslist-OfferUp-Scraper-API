        "dedupeValue": "={{ $json.listingId || $json.id || $json.url }}",
        "options": {}
      },
      "id": "92285f21-d4e5-52e0-abd2-473bafc2c6d1",
      "name": "3. Skip Seen Records",
      "type": "n8n-nodes-base.removeDuplicates",
